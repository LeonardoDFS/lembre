{
  "name": "lembre",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p server/tsconfig.json && tsc -p web/tsconfig.json && vite build",
    "start": "node server/dist/index.js",
    "start:lan": "cross-env LEMBRE_LAN=1 node server/dist/index.js",
    "test": "node --import tsx --test server/*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
